# Copy to compose/.env and edit.  cp compose/.env.example compose/.env

# --- Postgres ---
POSTGRES_USER=engram
POSTGRES_PASSWORD=P@ssw0rd
POSTGRES_DB=engram

# --- engram service ---
# Image tag pulled from ghcr.io/davasorus/engram. Pin a release for
# reproducible deploys; 'latest' tracks the newest tag.
ENGRAM_VERSION=0.1.0
ENGRAM_PORT=8088
ENGRAM_PG_PORT=55432

# Embedding vector width — MUST match your embed model's output dimension.
# nomic-embed-text-v1.5 = 768.
ENGRAM_DIMS=768

# --- Embeddings endpoint (LM Studio or any OpenAI-compatible server) ---
#
# This is the FIRST-CLASS case: native podman/docker on Linux, including
# WSL2 running podman/docker directly inside the distro (not podman machine
# or Docker Desktop — see docs/NETWORKING.md if that's you instead).
#
# compose.yml adds `extra_hosts: host.containers.internal:host-gateway`,
# so this resolves to whatever Linux considers its default route gateway —
# which, in WSL2, is the Windows host. Two situations:
#
#   1. Embedding server runs on the SAME machine as this compose stack
#      (e.g. LM Studio on Windows, engram in WSL2 on that same PC):
#      the default below just works. Nothing to change.
ENGRAM_EMBED_URL=http://localhost:1234
ENGRAM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

#   2. Embedding server runs on a DIFFERENT machine, or you've bound it to
#      a specific interface rather than serving on all interfaces: replace
#      the line above with that host's real IP/hostname, e.g.:
#      ENGRAM_EMBED_URL=http://192.168.1.50:1234
#
# `./scripts/detect-embed-url.sh` prints what host.containers.internal
# currently resolves to on this machine and pokes port 1234, useful if
# case 1 isn't working and you're not sure why.

# MCP tool allowlist exposed to agents. Small local models call tools more
# reliably with a minimal surface; mem_patch/mem_list/mem_links/mem_delete
# remain available via REST and the web UI. Empty = expose all seven.
ENGRAM_MCP_TOOLS=