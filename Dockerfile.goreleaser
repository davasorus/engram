# Dockerfile.goreleaser — used ONLY by GoReleaser for release images.
#
# GoReleaser builds docker images from a MINIMAL context containing just this
# file and the already-compiled binary for the target arch — no repo source.
# So unlike the main Dockerfile (multi-stage, compiles from source, used by
# compose and local builds), this one only layers the prebuilt binary onto
# the runtime base. Same final image either way: distroless + static binary.
#
# Keep the base image digest in sync with the main Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a
COPY engram /engram
EXPOSE 8088
ENTRYPOINT ["/engram"]
