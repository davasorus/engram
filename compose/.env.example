# Copy to compose/.env and edit.  cp compose/.env.example compose/.env

# --- Postgres ---
POSTGRES_USER=engram
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engram

# --- engram service ---
ENGRAM_PORT=8088
ENGRAM_PG_PORT=55432
ENGRAM_VERSION=0.1.0


# Embedding vector width — MUST match your embed model's output dimension.
# nomic-embed-text-v1.5 = 768.
ENGRAM_DIMS=768

# Embeddings endpoint (LM Studio). From inside the container the host is NOT
# localhost — use the container→host address:
#   Podman/WSL:      http://host.containers.internal:1234
#   Docker Desktop:  http://host.docker.internal:1234
#
# CAUTION for LM Studio on WINDOWS with engram in WSL2 Podman:
# host.containers.internal resolves to the WSL2 VM, not the Windows host, so
# it will NOT reach LM Studio. Use the Windows-host gateway IP + the netsh
# portproxy port (the same route the Go agent uses):
#
#   echo "ENGRAM_EMBED_URL=http://$(ip route show default | awk '{print $3}'):1235" >> compose/.env
#
# (With WSL2 "mirrored" networking mode, localhost:1234 works instead.)
ENGRAM_EMBED_URL=http://host.containers.internal:1234
ENGRAM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# MCP tool allowlist exposed to agents. Small local models call tools more
# reliably with a minimal surface; mem_patch/mem_list/mem_links/mem_delete
# remain available via REST and the web UI. Empty = expose all seven.
ENGRAM_MCP_TOOLS=mem_search,mem_read,mem_write
