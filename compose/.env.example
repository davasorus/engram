# Copy to compose/.env and edit.  cp compose/.env.example compose/.env

# --- Postgres ---
POSTGRES_USER=engram
POSTGRES_PASSWORD=change-me
POSTGRES_DB=engram

# --- engram service ---
ENGRAM_PORT=8088

# Embedding vector width — MUST match your embed model's output dimension.
# nomic-embed-text-v1.5 = 768.
ENGRAM_DIMS=768

# Embeddings endpoint (LM Studio). From inside the container the host is NOT
# localhost — use the container→host address:
#   Podman/WSL:      http://host.containers.internal:1234
#   Docker Desktop:  http://host.docker.internal:1234
ENGRAM_EMBED_URL=http://host.containers.internal:1234
ENGRAM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
